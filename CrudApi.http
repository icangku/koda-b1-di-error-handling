@baseUrl = http://localhost:5126

GET {{baseUrl}}/weatherforecast/
Accept: application/json

### Get Product All
GET {{baseUrl}}/api/v1/products
Accept: application/json

### Get Product By Code
GET {{baseUrl}}/api/v1/products/product/PR002
Accept: application/json

### Get Product By Customer Id
GET {{baseUrl}}/api/v1/products/customer/2
Accept: application/json

### POST Product
POST {{baseUrl}}/api/v1/products
Accept: application/json
Content-Type: application/json

{
    "code": "PR006",
    "name": "Babi",
    "price": 3000,
    "stock": 12,
    "category": "Hewan",
    "customerId": 2
}

### Upload Gambar
POST {{baseUrl}}/api/v1/products/PR002/image
Content-Type: multipart/form-data; boundary=CrudApi

--CrudApi
Content-Disposition: form-data; name="file"; filename="menu.jpg"
Content-Type: image/jpeg

< /home/alvin/Pictures/Taburai-Koda/menu.jpg
--CrudApi--

### UPDATE DATA
PUT {{baseUrl}}/api/v1/products/PR002
Accept: application/json
Content-Type: application/json

{
    "name": "Remote",
    "price": 35000,
    "stock": 20,
    "category": "TV"
}

### Delete Product
DELETE {{baseUrl}}/api/v1/products/P001
Accept: application/json

### Get Customer All
GET {{baseUrl}}/api/v1/customers
Accept: application/json

### Get Customer By Id
GET {{baseUrl}}/api/v1/customers/C001
Accept: application/json

### POST Customer
POST {{baseUrl}}/api/v1/customers
Accept: application/json
Content-Type: application/json

{
    "code": "C002",
    "name": "Banda",
    "email": "banda@haram.com",
    "phone": "087777777",
    "address": "Jl. Bogor Bandung"
}

### UPDATE Customer
PUT {{baseUrl}}/api/v1/customers/C001
Accept: application/json
Content-Type: application/json

{
    "name": "Badi",
    "email": "badi@halal.com",
    "phone": "0851111111",
    "address": "Jl. Paledang Bogor"
}

### Delete Customer
DELETE {{baseUrl}}/api/v1/customers/C001
Accept: application/json